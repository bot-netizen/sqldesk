#!/bin/bash
set -e

scheduler() {
  echo "Starting RQ scheduler..."

  exec /app/manage.py rq scheduler
}

dev_scheduler() {
  echo "Starting dev RQ scheduler..."

  exec watchmedo auto-restart --directory=./sqldesk/ --pattern=*.py --recursive -- ./manage.py rq scheduler
}

worker() {
  echo "Starting RQ worker..."

  export WORKERS_COUNT=${WORKERS_COUNT:-2}
  export QUEUES=${QUEUES:-}
  export SQLDESK_PROCESS_ROLE=worker

  exec supervisord -c bin/worker.conf
}

# Are this container's own workers alive?
#
# Asks the supervisord in this container, not Redis. The check this replaced
# counted the workers registered in Redis and compared them with this pod's
# WORKERS_COUNT -- which is every pod's workers against one pod's expectation,
# so a pod whose workers were all dead still passed as long as its neighbours
# were alive. As a liveness probe that is worse than nothing: it restarts
# healthy pods under load and never restarts the broken one.
#
# RUNNING and STARTING both count as alive: worker.conf sets startsecs=300, so
# a worker that has just started sits in STARTING for five minutes. FATAL is
# supervisord saying it has given up restarting, which is when the pod should
# go.
workers_healthcheck() {
  status=$(supervisorctl -s unix:///tmp/supervisor.sock status worker:* 2>&1) || true

  case "$status" in
    *"refused connection"*|*"no such file"*|*SHUTDOWN_STATE*)
      echo "supervisord is not answering:"
      echo "$status"
      exit 1
      ;;
  esac

  if [ -z "$status" ]; then
    echo "supervisord reports no worker processes at all"
    exit 1
  fi

  dead=$(echo "$status" | grep -Ev '[[:space:]](RUNNING|STARTING)[[:space:]]*' || true)
  if [ -n "$dead" ]; then
    echo "not running:"
    echo "$dead"
    exit 1
  fi

  echo "$status"
  exit 0
}

# Is the scheduler still going round its loop?
#
# The scheduler writes `sqldesk:scheduler:heartbeat` with a ninety-second TTL
# every pass (see sqldesk/tasks/schedule.py, which explains why it is ours and
# not rq-scheduler's). Gone means the loop has stopped -- the failure Kubernetes
# cannot see for itself, because the process is still up and nothing is being
# scheduled. Issue #1 was exactly that.
#
# Redis directly rather than manage.py: a probe should not load the
# application, forty query runners and a database connection every minute.
scheduler_healthcheck() {
  exec python -c "
import os, sys
import redis

url = os.environ.get('SQLDESK_REDIS_URL') or os.environ.get('REDIS_URL')
if not url:
    sys.exit('no SQLDESK_REDIS_URL to check against')
if redis.from_url(url).exists('sqldesk:scheduler:heartbeat'):
    print('the scheduler is looping')
    sys.exit(0)
sys.exit('no scheduler heartbeat in the last 90 seconds -- the loop has stopped')
"
}

dev_worker() {
  echo "Starting dev RQ worker..."

  exec watchmedo auto-restart --directory=./sqldesk/ --pattern=*.py --recursive -- ./manage.py rq worker $QUEUES
}

server() {
  # Recycle gunicorn workers every n-th request. See http://docs.gunicorn.org/en/stable/settings.html#max-requests for more details.
  MAX_REQUESTS=${MAX_REQUESTS:-1000}
  MAX_REQUESTS_JITTER=${MAX_REQUESTS_JITTER:-100}
  TIMEOUT=${SQLDESK_GUNICORN_TIMEOUT:-60}
  BIND_ADDRESS=${SQLDESK_GUNICORN_BIND:-[::]:5000}

  # Threads, not processes alone.
  #
  # Four sync workers means four requests at a time for the whole install, and
  # several ordinary requests hold a worker for seconds while waiting on
  # something else: MCP's run_query, Test connection, sharing to Slack, a
  # stream query. Four slow ones and the fifth person gets nothing -- the
  # health probe included, which is how a busy install gets itself restarted.
  # gthread serves each request on a thread, so waiting costs a thread rather
  # than a process. 4 x 8 by default; SQLDESK_WEB_WORKERS still sizes the
  # processes, so an install that set it keeps the capacity it asked for.
  WORKER_CLASS=${SQLDESK_GUNICORN_WORKER_CLASS:-gthread}
  THREADS=${SQLDESK_WEB_THREADS:-8}

  # Which process this is, read by models/base.py to decide whether to put a
  # statement timeout on its database connections. The web tier gets one; a
  # worker storing a large result must not.
  export SQLDESK_PROCESS_ROLE=server

  exec /usr/local/bin/gunicorn -b "$BIND_ADDRESS" --name sqldesk -w${SQLDESK_WEB_WORKERS:-4} \
    --worker-class "$WORKER_CLASS" --threads "$THREADS" \
    sqldesk.wsgi:app --max-requests $MAX_REQUESTS --max-requests-jitter $MAX_REQUESTS_JITTER \
    --timeout $TIMEOUT --limit-request-line ${SQLDESK_GUNICORN_LIMIT_REQUEST_LINE:-0}
}

create_db() {
  exec /app/manage.py database create_tables
}

help() {
  echo "SQLDesk Docker."
  echo ""
  echo "Usage:"
  echo ""

  echo "server -- start SQLDesk server (with gunicorn)"
  echo "worker -- start a single RQ worker"
  echo "dev_worker -- start a single RQ worker with code reloading"
  echo "scheduler -- start an rq-scheduler instance"
  echo "dev_scheduler -- start an rq-scheduler instance with code reloading"
  echo ""
  echo "workers_healthcheck -- exit non-zero if this container's workers are not running"
  echo "scheduler_healthcheck -- exit non-zero if the scheduler has stopped looping"
  echo ""
  echo "shell -- open shell"
  echo "dev_server -- start Flask development server with debugger and auto reload"
  echo "debug -- start Flask development server with remote debugger via debugpy"
  echo "create_db -- create database tables"
  echo "manage -- CLI to manage sqldesk"
  echo "tests -- run tests"
}

tests() {
  export SQLDESK_DATABASE_URL="postgresql://postgres@postgres/tests"

  if [ $# -eq 0 ]; then
    TEST_ARGS=tests/
  else
    TEST_ARGS=$@
  fi
  exec pytest $TEST_ARGS
}

case "$1" in
  worker)
    shift
    worker
    ;;
  workers_healthcheck)
    shift
    workers_healthcheck
    ;;
  scheduler_healthcheck)
    shift
    scheduler_healthcheck
    ;;
  server)
    shift
    server
    ;;
  scheduler)
    shift
    scheduler
    ;;
  dev_scheduler)
    shift
    dev_scheduler
    ;;
  dev_worker)
    shift
    dev_worker
    ;;
  celery_healthcheck)
    shift
    echo "DEPRECATED: Celery has been replaced with RQ and now performs healthchecks autonomously as part of the 'worker' entrypoint."
    ;;
  dev_server)
    export FLASK_DEBUG=1
    exec /app/manage.py runserver --debugger --reload -h 0.0.0.0
    ;;
  debug)
    export FLASK_DEBUG=1
    export REMOTE_DEBUG=1
    exec /app/manage.py runserver --debugger --no-reload -h 0.0.0.0
    ;;
  shell)
    exec /app/manage.py shell
    ;;
  create_db)
    create_db
    ;;
  manage)
    shift
    exec /app/manage.py $*
    ;;
  tests)
    shift
    tests $@
    ;;
  help)
    shift
    help
    ;;
  *)
    exec "$@"
    ;;
esac
