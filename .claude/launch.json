{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "start",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "run",
        "start"
      ],
      "port": 3000
    },
    {
      "name": "docs",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "--directory",
        "docs"
      ],
      "port": 4173
    },
    {
      "name": "dev-minikube",
      "runtimeExecutable": "/usr/bin/env",
      "runtimeArgs": [
        "SQLDESK_BACKEND=http://127.0.0.1:5091",
        "pnpm",
        "exec",
        "webpack-dev-server"
      ],
      "port": 8080
    }
  ]
}
