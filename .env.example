# Copy to .env and fill in before running compose.prod.yaml.
#
# Generate each secret separately, and keep them: rotating SQLDESK_SECRET_KEY
# makes every stored data-source password unreadable, because that is the key
# they are encrypted with.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Signs session cookies.
SQLDESK_COOKIE_SECRET=

# Encrypts data-source credentials at rest. Losing or changing this means
# re-entering every data source's password.
SQLDESK_SECRET_KEY=

# Password for the bundled Postgres.
POSTGRES_PASSWORD=

# The address people reach SQLDesk on. Links in emails and alerts are built
# from it, so localhost here means localhost in somebody's inbox.
SQLDESK_HOST=http://localhost:5000

# Optional.
# The port SQLDesk is published on. On macOS, AirPlay Receiver holds port 5000
# and `up` fails with "address already in use" -- set something else here, or
# turn AirPlay Receiver off in System Settings > General > AirDrop & Handoff.
# SQLDESK_HOST above has to match whatever you pick.
# SQLDESK_PORT=5000
# The port is published on this machine only. To reach SQLDesk from other
# machines without a proxy in front, bind every interface -- and know that
# it is then plain HTTP to everyone who can reach the port.
# SQLDESK_BIND=0.0.0.0
# Proxies between the internet and SQLDesk: 0 here (there is none in
# compose.prod.yaml), 1 behind nginx or Caddy. Wrong, and either the login
# throttle can be dodged or every visitor looks like the proxy.
# SQLDESK_PROXIES_COUNT=0
# Gunicorn threads serving the API and pages. Raise for more people browsing.
# SQLDESK_WEB_WORKERS=4
# How many queries run at once. This is concurrency, not a rate: two workers
# and a 100ms query is ~20 queries a second, and two workers with a query that
# takes a minute is two queries a minute. Raise it to the number of queries you
# want in flight, and remember each one holds a connection to its data source
# for as long as it runs -- the warehouse's connection limit is the real
# ceiling, not this number.
# SQLDESK_WORKERS_COUNT=2
# SQLDESK_IMAGE=ghcr.io/bot-netizen/sqldesk:0.7.9

# Minutes between background schema refreshes, which is what keeps
# autocomplete and the schema browser current. Three hours by default: every
# source is read on every pass, so this is the most expensive periodic job
# here. The schema browser's refresh button forces a live read of one source,
# which covers "I just added a table". Running a query never depends on it.
# SQLDESK_SCHEMAS_REFRESH_SCHEDULE=180

# Mail, if you want alerts and invitations delivered.
# SQLDESK_MAIL_SERVER=
# SQLDESK_MAIL_PORT=587
# SQLDESK_MAIL_USERNAME=
# SQLDESK_MAIL_PASSWORD=
# SQLDESK_MAIL_USE_TLS=true
# SQLDESK_MAIL_DEFAULT_SENDER=

# --- Pictures in alert emails (optional) ------------------------------------
# Off unless you run the renderer, which is a separate container because it
# carries a browser: start compose with --profile rendering, and uncomment
# these three. Without them, alerts behave exactly as they always have.
# SQLDESK_FEATURE_ALERT_SCREENSHOTS=true
# SQLDESK_SCREENSHOT_URL=http://screenshots:3000
# How the renderer reaches this application. Another container, so not localhost.
# SQLDESK_INTERNAL_BASE_URL=http://server:5000
# A secret the worker shows the renderer, so nothing else on the Docker
# network can ask it to fetch pages. Generate one like the secrets above.
# SQLDESK_SCREENSHOT_TOKEN=

# --- MCP and the catalog (0.6) -------------------------------------------
# The /mcp endpoint, the scheduled catalog harvest and Admin -> Catalog. Off by
# default. SQLDesk calls no model itself: the model is the MCP client's.
# SQLDESK_FEATURE_AI=true
# Give MCP's queries a queue of their own, and start compose with
# --profile mcp so a worker takes it. Without this they share the data
# source's queue with dashboards.
# SQLDESK_MCP_QUEUE=mcp

# Kafka streams. Start compose with --profile streams, which runs the workers
# that consume topics, and switch the feature on. Off by default: on without
# that profile, the Streams pages never fill.
# SQLDESK_STREAMS_ENABLED=true
# SQLDESK_STREAM_WORKERS_COUNT=2

# How often the catalog is rebuilt, in hours, when SQLDESK_FEATURE_AI is on.
# 0 to turn it off and run `manage ai harvest` yourself.
# SQLDESK_CATALOG_HARVEST_SCHEDULE=24
# How far back the catalog looks for the queries it learns from, in hours,
# measured by when a query last *ran*. A week by default; 0 for every saved
# query however old.
# SQLDESK_CATALOG_USAGE_WINDOW_HOURS=168
# Where `manage ai export` writes the semantic layer and `manage ai import`
# reads it. A directory on the host, so you can commit what comes out --
# point it at a checkout of your model repo and export straight into it.
# SQLDESK_SEMANTIC_DIR=./semantic
