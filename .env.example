# Copy to .env and fill in before running compose.prod.yaml.
#
# Generate each secret separately, and keep them: rotating TEALDASH_SECRET_KEY
# makes every stored data-source password unreadable, because that is the key
# they are encrypted with.
#
#   python -c "import secrets; print(secrets.token_urlsafe(32))"

# Signs session cookies.
TEALDASH_COOKIE_SECRET=

# Encrypts data-source credentials at rest. Losing or changing this means
# re-entering every data source's password.
TEALDASH_SECRET_KEY=

# Password for the bundled Postgres.
POSTGRES_PASSWORD=

# The address people reach Tealdash on. Links in emails and alerts are built
# from it, so localhost here means localhost in somebody's inbox.
TEALDASH_HOST=http://localhost:5000

# Optional.
# The port Tealdash is published on. On macOS, AirPlay Receiver holds port 5000
# and `up` fails with "address already in use" -- set something else here, or
# turn AirPlay Receiver off in System Settings > General > AirDrop & Handoff.
# TEALDASH_HOST above has to match whatever you pick.
# TEALDASH_PORT=5000
# TEALDASH_WEB_WORKERS=4
# TEALDASH_WORKERS_COUNT=2
# TEALDASH_IMAGE=ghcr.io/tdot-labs/tealdash:0.1.1

# Mail, if you want alerts and invitations delivered.
# TEALDASH_MAIL_SERVER=
# TEALDASH_MAIL_PORT=587
# TEALDASH_MAIL_USERNAME=
# TEALDASH_MAIL_PASSWORD=
# TEALDASH_MAIL_USE_TLS=true
# TEALDASH_MAIL_DEFAULT_SENDER=
